# === Database ===
# SQLite (dev):   sqlite+aiosqlite:///data/legal_docs.db
# PostgreSQL:     postgresql://user:pass@localhost:5432/legal_docs
DATABASE_URL=sqlite+aiosqlite:///data/legal_docs.db

# === TVPL (Thư viện Pháp luật) ===
TVPL_USERNAME=company_account@email.com
TVPL_PASSWORD=your_password_here

# === Telegram ===
TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
TELEGRAM_CHAT_ID=-100123456789
TELEGRAM_ADMIN_CHAT_ID=123456789

# === Google Drive ===
GDRIVE_SERVICE_ACCOUNT_FILE=credentials/gdrive_service_account.json
GDRIVE_ROOT_FOLDER_ID=1ABCxyz_your_folder_id_here

# === Lark Drive (Feishu / Lark Suite) ===
LARK_APP_ID=cli_1234567890
LARK_APP_SECRET=your_lark_app_secret_here
# BẮT BUỘC: token của thư mục do BẠN tạo trong Lark Drive và đã chia sẻ quyền
# "Có thể chỉnh sửa" cho app. Để trống → file rơi vào My Space của app, không ai
# mở được (Lark không có API chia sẻ thư mục). Kiểm tra: python scripts/lark_check.py
LARK_ROOT_FOLDER_TOKEN=FLD_your_folder_token_here
LARK_DOMAIN=open.larksuite.com
# Mỗi văn bản một thư mục con riêng, gom file TVPL + Bộ Tư pháp vào cùng chỗ
LARK_FOLDER_PER_DOC=true
# Xoá file .docx dưới data/ sau khi upload thành công
AUTO_CLEANUP_LOCAL_FILES=true


# === Pipeline Config ===
TVPL_RATE_LIMIT_SECONDS=7
# Tải .docx từ TVPL. Cần cài Google Chrome trên máy chạy — xem §2.5.
# Đặt false nếu chỉ dùng toàn văn từ Bộ Tư pháp (chạy nhanh hơn nhiều).
TVPL_DOWNLOAD_ENABLED=true
# Chạy Chrome thật rồi gắn qua CDP. Bắt buộc để vượt Cloudflare của TVPL;
# đặt false sẽ dùng Chromium của Playwright và gần như chắc chắn bị chặn.
TVPL_USE_CDP=true
TVPL_CDP_PORT=9222
# Tài khoản TVPL có hạn mức tải/ngày (đo được ~45 lượt). Vượt hạn mức thì trang
# vẫn mở nhưng link tải biến mất. Trần này giữ mỗi lần chạy dưới hạn mức.
TVPL_MAX_DOWNLOADS_PER_RUN=40
# Bao nhiêu văn bản liên tiếp không có link tải thì coi như hết hạn mức và dừng
TVPL_MISSING_LINK_STREAK=5
# Để trống = tự dò đường dẫn Chrome mặc định theo hệ điều hành.
# Windows: C:\Program Files\Google\Chrome\Application\chrome.exe
TVPL_CHROME_PATH=
# Hồ sơ Chrome riêng của pipeline (giữ phiên đăng nhập TVPL, tách khỏi Chrome cá nhân)
TVPL_CHROME_PROFILE_DIR=
MOJ_WINDOW_DAYS=30
# Trần số trang quét MOJ mỗi lần chạy (chặn vòng lặp vô hạn)
MOJ_MAX_PAGES=40
DAILY_RUN_HOUR=6
