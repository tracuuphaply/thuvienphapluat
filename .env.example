# === Database ===
# SQLite (dev):   sqlite+aiosqlite:///data/legal_docs.db
# PostgreSQL:     postgresql://user:pass@localhost:5432/legal_docs
DATABASE_URL=sqlite+aiosqlite:///data/legal_docs.db

# === TVPL (Thư viện Pháp luật) ===
TVPL_USERNAME=company_account@email.com
TVPL_PASSWORD=your_password_here

# === Telegram ===
TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
TELEGRAM_CHAT_ID=-100123456789
TELEGRAM_ADMIN_CHAT_ID=123456789

# === Nơi lưu trữ chính ===
# gdrive | lark. Trước đây suy từ việc có hay không LARK_APP_ID, nên chỉ cần
# điền khoá Lark là pipeline âm thầm đổi đích lưu trữ.
CLOUD_DRIVE_PROVIDER=lark

# Có đẩy văn bản kéo về theo dẫn chiếu (kể cả bản đã bị bãi bỏ) lên Drive không.
# Mặc định có: bản cũ là thứ trả lời được "quy định nào đã đổi", nên người đọc
# báo cáo phải mở được nó. Đặt false nếu chỉ muốn Drive chứa văn bản thuộc lĩnh
# vực doanh nghiệp — bao đóng có thể kéo về vài nghìn bản, mỗi bản 4 file.
UPLOAD_CLOSURE_NODES=true

# === Google Drive ===
# Xác thực bằng OAuth (Desktop app), KHÔNG dùng service account: Google cấp cho
# service account hạn mức lưu trữ 0 GB nên upload vào My Drive trả về
# 403 storageQuotaExceeded và không xin thêm quota được.
# Thiết lập: xem docs/VAN_HANH.md — nhớ bấm PUBLISH APP ở tab Audience, để
# trạng thái "Testing" thì refresh token hết hạn sau đúng 7 ngày.
GDRIVE_OAUTH_CLIENT_FILE=credentials/gdrive_oauth_client.json
GDRIVE_OAUTH_TOKEN_FILE=credentials/gdrive_token.json
# Để trống ở lần chạy đầu — script tự tạo thư mục gốc rồi điền id vào đây.
# Không trỏ tới thư mục bạn tạo tay: phạm vi drive.file chỉ ghi được vào thư mục
# do chính ứng dụng tạo.
GDRIVE_ROOT_FOLDER_ID=
GDRIVE_ROOT_FOLDER_NAME=Kho văn bản pháp luật

# === Lark Drive (Feishu / Lark Suite) ===
LARK_APP_ID=cli_1234567890
LARK_APP_SECRET=your_lark_app_secret_here
# BẮT BUỘC: token của thư mục do BẠN tạo trong Lark Drive và đã chia sẻ quyền
# "Có thể chỉnh sửa" cho app. Để trống → file rơi vào My Space của app, không ai
# mở được (Lark không có API chia sẻ thư mục). Kiểm tra: python scripts/lark_check.py
LARK_ROOT_FOLDER_TOKEN=FLD_your_folder_token_here
LARK_DOMAIN=open.larksuite.com
# Mỗi văn bản một thư mục con riêng, gom file TVPL + Bộ Tư pháp vào cùng chỗ
LARK_FOLDER_PER_DOC=true
# Xoá file .docx dưới data/ sau khi upload thành công
AUTO_CLEANUP_LOCAL_FILES=true


# === Pipeline Config ===
TVPL_RATE_LIMIT_SECONDS=7
# Tải .docx từ TVPL. Cần cài Google Chrome trên máy chạy — xem §2.5.
# Đặt false nếu chỉ dùng toàn văn từ Bộ Tư pháp (chạy nhanh hơn nhiều).
TVPL_DOWNLOAD_ENABLED=true
# Chạy Chrome thật rồi gắn qua CDP. Bắt buộc để vượt Cloudflare của TVPL;
# đặt false sẽ dùng Chromium của Playwright và gần như chắc chắn bị chặn.
TVPL_USE_CDP=true
TVPL_CDP_PORT=9222
# Tài khoản TVPL có hạn mức tải/ngày (đo được ~45 lượt). Vượt hạn mức thì trang
# vẫn mở nhưng link tải biến mất. Trần này giữ mỗi lần chạy dưới hạn mức.
TVPL_MAX_DOWNLOADS_PER_RUN=40
# Bao nhiêu văn bản liên tiếp không có link tải thì coi như hết hạn mức và dừng
TVPL_MISSING_LINK_STREAK=5
# Để trống = tự dò đường dẫn Chrome mặc định theo hệ điều hành.
# Windows: C:\Program Files\Google\Chrome\Application\chrome.exe
TVPL_CHROME_PATH=
# Hồ sơ Chrome riêng của pipeline (giữ phiên đăng nhập TVPL, tách khỏi Chrome cá nhân)
TVPL_CHROME_PROFILE_DIR=
MOJ_WINDOW_DAYS=30
# Trần số trang quét MOJ mỗi lần chạy (chặn vòng lặp vô hạn)
MOJ_MAX_PAGES=40
DAILY_RUN_HOUR=6

# === LLM & Embeddings ===
# Trước đây các biến này chỉ được đọc rải rác trong code, không có ở đây: người
# làm đúng theo hướng dẫn bàn giao nhận được crawler chạy tốt và bộ sinh báo cáo
# chết câm mà không có thông báo nào.
V98_API_KEY=sk-your_v98store_key_here
OPENAI_API_BASE=https://v98store.com/v1
# Dùng khi chuyển sang nhà cung cấp khác; để trống nếu đang dùng v98store.
OPENAI_API_KEY=
GEMINI_API_KEY=
REPORT_MODEL=gpt-4o
# Báo cáo tiếng Việt 4–6 trang vượt xa 8000 token; thấp hơn là bị cắt giữa chừng.
REPORT_MAX_TOKENS=16000
# Trỏ ra mẫu prompt ngoài repo; để trống = dùng mẫu trong src/rag/prompts/.
REPORT_PROMPT_PATH=
# Để trống = tự chọn theo khoá API đang có. Đổi model là đổi số chiều vector,
# bảng vec0 sẽ bị dựng lại.
EMBEDDING_MODEL=
EMBEDDING_DIM=
EMBEDDING_BATCH_SIZE=64

# === Thu thập theo mốc cố định & bao đóng dẫn chiếu ===
# Sàn quét cố định, không trôi theo ngày chạy như cửa sổ 30 ngày.
CLOSURE_SEED_FLOOR=2026-01-01
# Quét lùi quá watermark một quãng: văn bản được đăng lên hệ thống muộn hơn ngày
# ban hành, cắt đúng watermark sẽ bỏ sót vĩnh viễn văn bản đăng chậm.
CRAWL_OVERLAP_DAYS=45
CLOSURE_ENABLED=false
CLOSURE_MAX_FETCH_PER_RUN=300
# Văn bản bị dẫn chiếu quá nhiều vẫn được tải về nhưng không giãn nở tiếp từ nó.
CLOSURE_HUB_INDEGREE=200
CLOSURE_MAX_NODES=15000
# Dừng bao đóng khi đĩa còn dưới mức này (GB).
MIN_FREE_DISK_GB=5

# === Chấm điểm tác động & báo cáo ===
# Đổi công thức thì tăng version: kết quả cũ vẫn tra được để đối chiếu.
IMPACT_SCORER_VERSION=v1.0.0
MAX_REPORTS_PER_DAY=5
REPORT_B_COOLDOWN_DAYS=7

# === Trang công khai ===
PUBLIC_VAULT_BASE_URL=
PUBLISH_VAULT_ENABLED=false

# Bật bộ sinh báo cáo tự động trong run_daily.sh (gọi LLM, tốn tiền)
REPORT_WORKER_ENABLED=false
