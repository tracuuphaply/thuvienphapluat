data/reference_type_evidence.json
data/moj_target_ids.json
data/pipeline.lock
data/report_worker.lock

# Ánh xạ tên thư mục → id trên Google Drive, dựng lại được bằng một lượt chạy
data/gdrive_cache.json

# Vault Obsidian là kết quả sinh ra từ DB + data/ (đều đã ignore); dựng lại bằng
# `python -m src.main --sync-vault-only`. 75MB/1041 file, kèm workspace.json
# chứa đường dẫn máy cục bộ — không nên nằm trong git.
Legal-Vault/

# Allowlist quyền theo máy, không chia sẻ được
.claude/settings.local.json

# Thông tin thương hiệu riêng của từng người dùng
report_branding.json

# Cấu hình cục bộ của app Obsidian — chứa trạng thái workspace
# và đường dẫn trên máy người dùng, không phải cấu hình của dự án.
.obsidian/
