<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_TheoDoiVanBanPhapLuat" targetNamespace="https://thongtincty.com/bpmn" exporter="thuvienphapluat/scripts/generate_bpmn.py" exporterVersion="1.0">
  <bpmn:collaboration id="Collab_1">
    <bpmn:participant id="Pool_HeThong" name="Hệ thống theo dõi văn bản pháp luật" processRef="Process_1" />
  </bpmn:collaboration>
  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_ThuThap" name="Thu thập văn bản">
        <bpmn:flowNodeRef>Start_HangNgay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Khoa</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Quet_Split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_QuetTVPL</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_QuetMOJ</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Quet_Join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_CoVanBan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_NguonChet</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_XuLy" name="Xử lý &amp; lưu trữ">
        <bpmn:flowNodeRef>Task_GopTrung</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_NapChiTiet</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_LamSach</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_LuuDB</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_CoSuKien</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_TruyXuat" name="Truy xuất &amp; sinh báo cáo">
        <bpmn:flowNodeRef>Task_DongBo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Nhung</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TruyXuat</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_LocHieuLuc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SinhBaoCao</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DoiChieu</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_TrichDan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_ChanBaoCao</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_PhatHanh" name="Phát hành &amp; vận hành">
        <bpmn:flowNodeRef>Task_XuatPDF</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ThongBao</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SaoLuu</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_HoanTat</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_HangNgay" name="Đến giờ chạy hằng ngày&#10;(launchd 06:00)">
      <bpmn:outgoing>f01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_Khoa" name="Lấy khoá chống chạy chồng">
      <bpmn:incoming>f01</bpmn:incoming>
      <bpmn:outgoing>f02</bpmn:outgoing>
    </bpmn:task>
    <bpmn:parallelGateway id="GW_Quet_Split">
      <bpmn:incoming>f02</bpmn:incoming>
      <bpmn:outgoing>f03</bpmn:outgoing>
      <bpmn:outgoing>f04</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="Task_QuetTVPL" name="Quét RSS Thư viện pháp luật">
      <bpmn:incoming>f03</bpmn:incoming>
      <bpmn:outgoing>f05</bpmn:outgoing>
    </bpmn:task>
    <bpmn:serviceTask id="Task_QuetMOJ" name="Gọi API Bộ Tư pháp&#10;(quét theo cửa sổ ngày)">
      <bpmn:incoming>f04</bpmn:incoming>
      <bpmn:outgoing>f06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="GW_Quet_Join">
      <bpmn:incoming>f05</bpmn:incoming>
      <bpmn:incoming>f06</bpmn:incoming>
      <bpmn:outgoing>f07</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:exclusiveGateway id="GW_CoVanBan" name="Có văn bản&#10;nào không?">
      <bpmn:incoming>f07</bpmn:incoming>
      <bpmn:outgoing>f08</bpmn:outgoing>
      <bpmn:outgoing>f09</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_NguonChet" name="Ghi FAILED&#10;+ gửi cảnh báo">
      <bpmn:incoming>f08</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="Task_GopTrung" name="Gộp &amp; khử trùng&#10;theo doc_key">
      <bpmn:incoming>f09</bpmn:incoming>
      <bpmn:outgoing>f10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:serviceTask id="Task_NapChiTiet" name="Nạp chi tiết + quan hệ&#10;từ Bộ Tư pháp">
      <bpmn:incoming>f10</bpmn:incoming>
      <bpmn:outgoing>f11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:task id="Task_LamSach" name="Làm sạch, tách Điều/Khoản">
      <bpmn:incoming>f11</bpmn:incoming>
      <bpmn:outgoing>f12</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_LuuDB" name="Ghi CSDL, cập nhật&#10;lịch sử hiệu lực">
      <bpmn:incoming>f12</bpmn:incoming>
      <bpmn:outgoing>f13</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="GW_CoSuKien" name="Có sự kiện&#10;A / B / C?">
      <bpmn:incoming>f13</bpmn:incoming>
      <bpmn:outgoing>f14</bpmn:outgoing>
      <bpmn:outgoing>f26</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_DongBo" name="Đồng bộ vault Obsidian&#10;+ chỉ mục RAG">
      <bpmn:incoming>f14</bpmn:incoming>
      <bpmn:outgoing>f15</bpmn:outgoing>
    </bpmn:task>
    <bpmn:serviceTask id="Task_Nhung" name="Nhúng vector các đoạn mới">
      <bpmn:incoming>f15</bpmn:incoming>
      <bpmn:outgoing>f16</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:task id="Task_TruyXuat" name="Truy xuất theo ngành VSIC&#10;(BM25 + vector)">
      <bpmn:incoming>f16</bpmn:incoming>
      <bpmn:outgoing>f17</bpmn:outgoing>
    </bpmn:task>
    <bpmn:businessRuleTask id="Task_LocHieuLuc" name="Loại văn bản hết hiệu lực,&#10;gắn cảnh báo">
      <bpmn:incoming>f17</bpmn:incoming>
      <bpmn:outgoing>f18</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:serviceTask id="Task_SinhBaoCao" name="Sinh báo cáo qua API v98">
      <bpmn:incoming>f18</bpmn:incoming>
      <bpmn:outgoing>f19</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:businessRuleTask id="Task_DoiChieu" name="Đối chiếu số hiệu&#10;với cơ sở dữ liệu">
      <bpmn:incoming>f19</bpmn:incoming>
      <bpmn:outgoing>f20</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="GW_TrichDan" name="Trích dẫn&#10;hợp lệ?">
      <bpmn:incoming>f20</bpmn:incoming>
      <bpmn:outgoing>f21</bpmn:outgoing>
      <bpmn:outgoing>f22</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_ChanBaoCao" name="Chặn xuất bản,&#10;ghi số hiệu lạ">
      <bpmn:incoming>f21</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="Task_XuatPDF" name="Xuất PDF theo mẫu&#10;thương hiệu">
      <bpmn:incoming>f22</bpmn:incoming>
      <bpmn:outgoing>f23</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sendTask id="Task_ThongBao" name="Gửi bản tin Telegram">
      <bpmn:incoming>f23</bpmn:incoming>
      <bpmn:outgoing>f24</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:task id="Task_SaoLuu" name="Sao lưu CSDL &amp; sản phẩm">
      <bpmn:incoming>f24</bpmn:incoming>
      <bpmn:incoming>f26</bpmn:incoming>
      <bpmn:outgoing>f25</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_HoanTat" name="Hoàn tất lượt chạy">
      <bpmn:incoming>f25</bpmn:incoming>
    </bpmn:endEvent>
